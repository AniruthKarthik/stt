#!/bin/bash

# Find the project root directory (one level up from bin)
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$BIN_DIR/.." && pwd)"
TMP_DIR="$PROJECT_DIR/tmp"
PID_FILE="$TMP_DIR/record.pid"
AUDIO_FILE="$TMP_DIR/audio.wav"
LOG_FILE="$TMP_DIR/stt.log"
MODEL_PATH="$PROJECT_DIR/models/ggml-base.en.bin"

# Locate whisper-cli binary
WHISPER_CLI="$PROJECT_DIR/whisper.cpp/build/bin/whisper-cli"
if [ ! -x "$WHISPER_CLI" ]; then
    if [ -x "$PROJECT_DIR/whisper.cpp/bin/whisper-cli" ]; then
        WHISPER_CLI="$PROJECT_DIR/whisper.cpp/bin/whisper-cli"
    elif command -v whisper-cli &>/dev/null; then
        WHISPER_CLI="$(command -v whisper-cli)"
    fi
fi

mkdir -p "$TMP_DIR"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

# Auto-detect the active ydotool socket across Arch (user service) and other distros
get_ydotool_socket() {
    if [ -n "$YDOTOOL_SOCKET" ] && [ -S "$YDOTOOL_SOCKET" ]; then
        echo "$YDOTOOL_SOCKET"
    elif [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/.ydotool_socket" ]; then
        echo "$XDG_RUNTIME_DIR/.ydotool_socket"
    elif [ -S "/run/user/$(id -u)/.ydotool_socket" ]; then
        echo "/run/user/$(id -u)/.ydotool_socket"
    elif [ -S "/tmp/.ydotool_socket" ]; then
        echo "/tmp/.ydotool_socket"
    fi
}

# Run ydotool with the detected socket
run_ydotool() {
    local sock
    sock="$(get_ydotool_socket)"
    if [ -n "$sock" ]; then
        YDOTOOL_SOCKET="$sock" ydotool "$@" 2>>"$LOG_FILE"
    else
        ydotool "$@" 2>>"$LOG_FILE"
    fi
}

# Helper to type text via ydotool
type_text() {
    run_ydotool type -- "$1"
}

# Helper to type text safely with key release delay
type_text_safely() {
    sleep 0.2
    run_ydotool type -- "$1"
}

# Helper to erase inline feedback characters in a single batch
erase_feedback() {
    local count="${1:-12}"
    local args=()
    for ((i=0; i<count; i++)); do
        args+=(14:1 14:0)
    done
    run_ydotool key "${args[@]}"
}

# Ensure display environment variables exist even when spawned from systemd
ensure_display_env() {
    if [[ -z "$WAYLAND_DISPLAY" && -n "$XDG_RUNTIME_DIR" ]]; then
        for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
            if [[ -S "$s" ]]; then
                export WAYLAND_DISPLAY="$(basename "$s")"
                break
            fi
        done
    fi
    if [[ -z "$DISPLAY" ]]; then
        if [[ -S "/tmp/.X11-unix/X0" ]]; then
            export DISPLAY=":0"
        elif [[ -S "/tmp/.X11-unix/X1" ]]; then
            export DISPLAY=":1"
        fi
    fi
}

# Helper to paste text via clipboard for instant insertion
paste_text() {
    local text="$1"
    ensure_display_env
    local copied=false

    if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy &>/dev/null; then
        if printf "%s" "$text" | wl-copy 2>>"$LOG_FILE"; then
            copied=true
        fi
    elif [[ -n "$DISPLAY" ]] && command -v xclip &>/dev/null; then
        if printf "%s" "$text" | xclip -selection clipboard 2>>"$LOG_FILE"; then
            copied=true
        fi
    fi

    if [ "$copied" = true ]; then
        # Small delay to allow the clipboard to be populated and avoid race conditions
        sleep 0.1
        # Simulate Ctrl+v (Left Ctrl: 29, V: 47)
        run_ydotool key 29:1 47:1 47:0 29:0
    else
        log "Display clipboard unavailable, falling back to direct typing."
        type_text_safely "$text"
    fi
}

case "$1" in
    start)
        if [ -f "$PID_FILE" ]; then
            log "Already recording. Skipping."
            exit 0
        fi
        log "--- START RECORDING ---"

        # Inline feedback (animated typing)
        type_text_safely "recording..."

        rm -f "$AUDIO_FILE"

        # Start recording
        arecord -f S16_LE -r 16000 -c 1 -q "$AUDIO_FILE" 2>>"$LOG_FILE" &
        REC_PID=$!
        echo $REC_PID > "$PID_FILE"
        ;;

    stop)
        # Give 'start' a tiny moment to write the PID file
        for i in {1..10}; do
            [ -f "$PID_FILE" ] && break
            sleep 0.05
        done

        if [ ! -f "$PID_FILE" ]; then
            log "No recording in progress."
            exit 0
        fi

        PID=$(cat "$PID_FILE")
        rm -f "$PID_FILE"

        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            wait "$PID" 2>/dev/null
        fi

        log "Recording stopped. Transcribing..."

        # Erase "recording..." (12 characters) in a single batch
        sleep 0.1
        erase_feedback 12

        TEXT=$("$WHISPER_CLI" \
            -m "$MODEL_PATH" \
            -f "$AUDIO_FILE" \
            -nt \
            -np 2>>"$LOG_FILE" \
            | tr '\n' ' ' \
            | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')

        # Basic Hallucination/Silence Filter
        if [[ -z "$TEXT" || "$TEXT" =~ ^\[.*\]$ || "$TEXT" =~ ^\(.*\)$ || "$TEXT" == *"BLANK_AUDIO"* ]]; then
            log "Ignored hallucination: '$TEXT'"
            exit 0
        fi

        log "Transcription: $TEXT"

        # Paste the result instantly
        paste_text "$TEXT "
        log "Injected using clipboard/ydotool."
        ;;
esac
