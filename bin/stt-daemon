#!/bin/bash
# STT Trigger Daemon Launcher
# Ensures the lightweight C listener binary is built and runs it.

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$(cd "$BIN_DIR/.." && pwd)"
LISTENER_BIN="$BIN_DIR/stt-daemon-bin"
WHISPERSTT_PATH="$BIN_DIR/whisperstt"
SRC_C="$PROJECT_DIR/src/stt-daemon.c"

# Compile listener binary if missing or older than source
if [ ! -x "$LISTENER_BIN" ] || [ "$SRC_C" -nt "$LISTENER_BIN" ]; then
    if command -v gcc &>/dev/null; then
        gcc -O2 "$SRC_C" -o "$LISTENER_BIN" 2>/dev/null || true
    fi
fi

if [ -x "$LISTENER_BIN" ]; then
    exec "$LISTENER_BIN" "$WHISPERSTT_PATH"
fi

echo "Error: Could not build or run STT daemon listener ($LISTENER_BIN)." >&2
exit 1
